# Development Dockerfile for FastAPI backend with hot reload
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app/backend

# Install uv (pinned — a floating :latest tag makes builds unreproducible)
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /usr/local/bin/uv

# Copy dependency files. The lockfile is required, not optional.
COPY backend/pyproject.toml backend/uv.lock ./

# Install dependencies. The `dev` dependency-group (ruff, mypy, pytest) is
# included by default, so no --extra flag is needed.
RUN uv sync --frozen

# Copy application code (in dev, this will be overridden by volume mount)
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini

EXPOSE 3000

# Run migrations and start server with hot reload. Migrations must succeed
# before the server starts — suppressing the failure here just turns an obvious
# startup error into confusing "relation does not exist" 500s at request time.
CMD ["sh", "-c", "uv run alembic upgrade head && uv run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-3000} --reload"]
