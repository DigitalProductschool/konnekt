# Database
# Use port 5435 when connecting from host to Docker PostgreSQL
# Use port 5432 when running inside Docker (container-to-container)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/template_db

# Server
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:5173

# Environment
APP_ENV=development

# Base URL that serviceBW uses to reach the middleware; the connection URLs are built
# from it. Unset in development means http://localhost:3000. Required in any other
# environment, where it must use https:// unless ALLOW_PLAIN_HTTP=true.
CONNECTION_BASE_URL=http://localhost:3000

# EUDIPLO management API (tenant dps). Saving and triggering answer 503 while one is empty.
# Base URL of the EUDIPLO instance, without /api
EUDIPLO_URL=
# API client with the roles presentation:request + presentation:manage, and no allow-list
EUDIPLO_CLIENT_ID=
EUDIPLO_CLIENT_SECRET=
# Trust list that every credential query uses for issuer trust
EUDIPLO_TRUST_LIST_ID=

# Expiry of a document request, in seconds
REQUEST_LIFETIME_SECONDS=600
# Longest time shared documents stay in EUDIPLO, and the webhook retry limit, in seconds
DOCUMENT_RETENTION_SECONDS=1800
# How long repeated pulls return the same documents after the first delivery, in seconds
PULL_REPEAT_WINDOW_SECONDS=60
# How long a request record is kept after the request ended, in seconds (7 days)
REQUEST_RECORD_RETENTION_SECONDS=604800

# Allow http:// for webhook addresses, and for CONNECTION_BASE_URL outside development.
# Only for a closed network.
ALLOW_PLAIN_HTTP=false

# Run the background worker thread
WORKER_ENABLED=true

# How long a DO.IT sign-in lasts, in hours
LOGIN_SESSION_HOURS=8

# Only for the developer script scripts/issue_test_credentials, which issues a test PID and
# driving licence to a test wallet (README.md, "Test credentials for a test wallet"). The
# middleware ignores both. API client of the tenant with issuance:manage + issuance:offer
EUDIPLO_ISSUER_CLIENT_ID=
EUDIPLO_ISSUER_CLIENT_SECRET=
