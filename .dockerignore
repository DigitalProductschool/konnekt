# Both docker-compose services build with `context: .` (the repo root), so this
# is the only .dockerignore Docker reads. The ones in backend/ and frontend/ do
# not apply to those builds.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Node (the workspace root's and every package's)
node_modules/
**/node_modules/
frontend/dist/
mcp/dist/
npm-debug.log*

# Environment variables — never bake secrets into an image. `**/` matches them in
# every package too (backend/, frontend/, mcp/): a bare `.env` matches the root only
**/.env
**/.env.*
!**/.env.example

# Database
*.db
*.sqlite

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
