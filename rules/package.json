{
  "name": "@konnekt/rules",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@konnekt/api-types": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
