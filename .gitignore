# Dependencies
/frontend/node_modules/

# Build outputs
dist/
build/
/frontend/dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
/backend/.venv/

# uv
.uv/

# NOTE: backend/uv.lock and backend/.python-version are deliberately NOT ignored.
# Both must be committed: the Dockerfiles install with `uv sync --frozen`, which
# fails without the lockfile, and .python-version pins the interpreter version so
# every clone resolves the same one.

# Environment files
.env
.env.local
.env.*.local
/backend/.env
/frontend/.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Docker volumes (local)
postgres-data/

# Database
*.db

# Claude Code: commit .claude/ (skills, agents, shared settings), but keep
# personal settings, local agent memory and Claude-made worktrees out.
# The **/ also covers Claude sessions started in frontend/ or backend/.
**/.claude/settings.local.json
**/.claude/agent-memory-local/
**/.claude/worktrees/

# spec-kit: commit .specify/ (constitution, scripts, templates), since the
# /speckit-* skills need it in every branch and worktree. Keep the per-checkout
# feature pointer and the specify CLI's local config, caches, backups, locks
# and workflow runs out.
.specify/feature.json
.specify/extensions/*/local-config.yml
.specify/extensions/.backup/
.specify/**/.cache/
.specify/.workflow-install.lock
.specify/workflows/runs/

resume.sh
