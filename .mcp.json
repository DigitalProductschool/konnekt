{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--executable-path",
        "/usr/sbin/google-chrome-stable",
        "--isolated",
        "--viewport-size",
        "1440x900"
      ],
      "env": {}
    }
  }
}
