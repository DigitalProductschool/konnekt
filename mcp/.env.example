# The MCP server's settings (mcp/src/config.ts). The server reads them from the environment
# when it starts, not from this file: export them in the shell that starts it, for example
# `set -a; . mcp/.env; set +a` before `npm run dev -w mcp`. The values below are the
# development defaults, which apply whenever NODE_ENV isn't production. With
# NODE_ENV=production the four URLs are required: the server doesn't start without them.

# Port the server listens on
PORT=3100

# The backend's address, which every tool call goes to (http://backend:3000 in Docker)
BACKEND_URL=http://localhost:3000

# Public origin of the management interface, which links are built from; the backend's PORTAL_URL
PORTAL_URL=http://localhost:5173

# Public URL of the MCP endpoint, the OAuth resource indicator; the backend's MCP_URL
MCP_URL=http://localhost:3100/mcp

# Issuer of the OAuth authorization server (the backend); the backend's OAUTH_ISSUER
OAUTH_ISSUER=http://localhost:3000
